class CryptoWallet {
    balance;
    fee;

    ~CryptoWallet() {
        this.balance = 0;
        this.fee = 10;
    }

    deposit(amount) {
        if (amount <= this.fee) {
            // throw "Amount cannot be less than the fee";
        }
        amount = amount - this.fee;
        this.balance = this.balance + amount;
    }

    withdraw(amount) {
        // Whoops, forgot about the fee
        if (this.balance < amount) {
            // throw "Cannot withdraw more than you have";
        }

        this.balance = this.balance - this.fee;
        this.balance = this.balance - amount;
    }
}


class Main {
    main() {
        def wallet = new CryptoWallet();

        def inheritance = 2147483647; // 2^31 - 1
        wallet.deposit(inheritance);

        def paycheck = 4000;
        wallet.deposit(paycheck);
    }
}