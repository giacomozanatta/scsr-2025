class DivByZeroTest{

    print(s){
        //Print a text on the screen
    }


    calculate_e() {
        def e = 0;
        def factorial = 1;
        def max_terms = 10000;
        for (def i = 0; i < max_terms; i = i + 1) {
            if (i > 0) {
                factorial = factorial * i;
            }
            def tmp = 1 / factorial;
            e = e + tmp;
        }
        this.print(e);
    }

