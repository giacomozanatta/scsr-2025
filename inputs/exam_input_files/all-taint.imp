class Params {
	
	count;
	values;
	
	~Params() {
		this.count = 0;
		this.values = new string[100];
	}
	
	add(newValue) {
		def updated = this.values;
		def idx = this.count;
		updated[idx] = newValue;
		this.values = updated;
		this.count = this.count + 1;
	}
}

class CustomerHandler2 {
	
	doSearch() {
		def agencyId    = "1234";
		def searchBy    = this.getFormField("searchBy");
		def searchValue = this.getFormField("searchValue");
