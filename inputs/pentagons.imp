class pentagons {

	basic() {
	
		def arr = new int[5];
		def i = 0;
		
		while(i < arraylen(arr)) {
			arr[i] = i;
			i = i + 1;
		}
	}
	
	arrayoutofbounds() {
	
		def arr = new int[5];
		def i = 0;
		
		while(i <= arraylen(arr)) {
			arr[i] = i; // out of bounds
			i = i + 1;
		}
	}

	run() {
        def n = 8;
        def acc = 28;
        while (n > 0) {
            n = n - 1;
            acc = acc - n;
        }
        // Here acc is exactly zero (28 - (7+6+...+1+0) == 0)
        def res = 1 / acc; // Division by zero: Pentagons detect definitely, Intervals only possibly
    }
}
