class DivByZeroTest{
    example(){

        def zero = 0;
    //    def zero_f = 0.0;

        def one = 1;
    //    def one_f = 1.0;

        def two = 2;
    //    def two_f = 2.0;

        def minus_one = -1;
    //    def minus_one_f = -1.0;

        def minus_two = -2;
    //    def minus_two_f = -2.0;

        def expr1 = one / zero;
        def expr2 = minus_one / minus_two;
        def expr3 = two / zero;

        def error1 = (((3 * 4 - minus_two) / two) - 7) / zero;
        def error2 = (((two + 7) / 3) - one) / ((minus_two + two) + (one + minus_one) - (minus_two / 0));
        def error3 = ((7 * (9 + 4) - (4 / 2)) + (6 * 1 - 3) * (minus_two + minus_one)) /
                     (((8 / 2) + (3 - 1)) - (5 + (1 * 1)));
    }
}