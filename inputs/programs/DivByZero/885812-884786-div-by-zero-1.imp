    def minus_two = -2;
    def minus_two_f = -2.0;

    def expr1 = one / zero;
    def expr2 = minus_one_f / minus_two;
    def expr3 = two / zero_f;

    def error1 = (((3 * 4 - minus_two_f) / two) - 7) / zero_f;
    def error2 = (((two + 7) / 3.0) - one_f) / ((minus_two + two) + (one + minus_one) - (minus_two / 0.0));
    def error3 = ((7.5 * (9 + 4) - (4.0 / 2.0)) + (6 * 1.2 - 3) * (minus_two_f + minus_one)) /
                 (((8 / 2.0) + (3.5 - 1.5)) - (5 + (1.0 * 1)));

}