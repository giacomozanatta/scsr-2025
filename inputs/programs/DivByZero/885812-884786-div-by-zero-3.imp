class DivByZeroTest{
    example(){
        def iteration = 20.0;
        def var = -20.0;
        def res = 0.0;

        while(iteration != var) {

            iteration = iteration - 1.0;
            res = iteration / var;
            var = var + 1.0;

            if (var == -5.0) {
                res = res + 1.0;
            }

        }

        return ((iteration + 1.0) / var) + res;
    }

}