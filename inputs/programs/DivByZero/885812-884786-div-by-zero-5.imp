class DivByZeroTest{

    // Define f'(x) = (u' * v - u * v') / (v * v)

    derivative(u, up, v, vp) {
        return (up * v - u * vp) / (v * v);
    }

    example1(){

        // Test 1: f(x) = (x^2 + 3x + 2) / (x + 1), x = -1
        def x1 = -1;

        def u1 = x1 * x1 + 3 * x1 + 2;
        def u1p = 2 * x1 + 3;

        def v1 = x1 + 1;
        def v1p = 1;
        def res = u1 / v1;

        def d1 = this.derivative(u1, u1p, v1, v1p);  // Expected Division By Zero
    }

    example2(){

        // Test 2 (float): f(x) = (2x + 5) / (x^2 - 4), x = 2.0
        def x2 = 2;

        def u2 = 2 * x2 + 5;      // u(x) = 2x + 5
        def u2p = 2;                // u'(x) = 2

        def v2 = x2 * x2 - 4;       // v(x) = x^2 - 4
        def v2p = 2 * x2;           // v'(x) = 2x
        def res = u2 / v2;

        def d2 = this.derivative(u2, u2p, v2, v2p);  // Expected: Division by Zero (denominator = 0.0)

    }

    example3(){
        // Test 3: division by zero only in the derivative, f(x) = x^2 / (x^2 - 1)
        def x3 = 4;
        def x4 = 4;
        def df1 = 0;

        while(x3 > -4) {

            // f(x1)
            def num1 = x3 * x3;
            def den1 = x3 * x3 - 1;
            def res = num1 / den1;

            // f'(x2)
            def num2 = x4 * x4;
            def den2 = x4 * x4 - 1;
            def deriv_num = 2 * x3;
            def deriv_den = (x4 * x4 - 1) * (x4 * x4 - 1);

            df1 = this.derivative(num2, deriv_num, den2, deriv_den); // Expected Division By Zero only for x4 = 1

            x3 = x3 - 1;
            x4 = x4 - 1;
        }
    }
}