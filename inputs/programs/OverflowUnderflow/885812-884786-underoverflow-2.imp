class OverflowUnderflowTests {

    // ----------- Integer Overflow / Underflow Tests -----------

    // Integer overflow: x = 2147483647 + 1
    def x = 2147483647;
    x = x + 1; // INT32 overflow expected

    // Integer underflow: x = -2147483648 - 1
    def y = -2147483648;
    y = y - 1; // INT32 underflow expected

    // Integer multiplication overflow: 100000 * 100000
    def a = 100000;
    def b = 100000;
    def z = a * b; // overflow expected

    // Integer multiplication underflow: -100000 * 100000
    def c = -100000;
    def d = 100000;
    def w = c * d; // underflow expected

    // Division overflow: -2147483648 / -1
    def e = -2147483648;
    def f = -1;
    def div = e / f; // overflow in INT32

    // ----------- Unsigned 8-bit Overflow / Underflow Simulation -----------

    def u1 = 250;
    u1 = u1 + 10; // UINT8 overflow if treated as unsigned 8-bit

    def u2 = 5;
    u2 = u2 - 10; // UINT8 underflow if treated as unsigned 8-bit

    // ----------- Floating-Point Overflow / Underflow -----------

    def fx = 3.4e38;
    fx = fx * 10.0; // FLOAT32 overflow

    def fy = -3.4e38;
    fy = fy * 10.0; // FLOAT32 underflow

    // ----------- Control Flow Based Overflow -----------

    def flag = 1;
    def gx = 2147483640;
    if (flag) {
        gx = gx + 100; // overflow if flag is true
    }

    // ----------- Loop-Based Overflow -----------

    def lx = 2147483600;
    def i = 0;
    while (i < 10) {
        lx = lx + 10; // overflow after a few iterations
        i = i + 1;
    }

    // ----------- Parameterized Overflow / Underflow -----------

    // Simulate input: a = 8 (would cause overflow)
    def a_in = 8;
    def x1 = 2147483640;
    x1 = x1 + a_in; // overflow if a_in > 7

    // Simulate input: b = 9 (would cause underflow)
    def b_in = 9;
    def x2 = -2147483640;
    x2 = x2 - b_in; // underflow if b_in > 7

    // Simulate multiplication overflow: a = 50000, b = 50000
    def a2 = 50000;
    def b2 = 50000;
    def x3 = a2 * b2; // overflow expected

    // Simulate UINT8 overflow: a = 10
    def u3 = 250;
    def a3 = 10;
    u3 = u3 + a3; // overflow if a3 > 5

    // Simulate UINT8 underflow: a = 10
    def u4 = 5;
    def a4 = 10;
    u4 = u4 - a4; // underflow if a4 > 5

    // Simulate float overflow: a = 2.0
    def f1 = 3.4e38;
    def a5 = 2.0;
    f1 = f1 * a5; // float overflow if a5 > 1.0

    // Simulate float underflow: a = -2.0
    def f2 = -3.4e38;
    def a6 = -2.0;
    f2 = f2 * a6; // float underflow if a6 < -1.0

    // Loop overflow: simulate param n = 6
    def n = 6;
    def lp = 2147483600;
    def j = 0;
    while (j < n) {
        lp = lp + 10; // overflow if n > 4
        j = j + 1;
    }

    // Branch underflow with param: flag = true, a = 10
    def flag2 = 1;
    def a7 = 10;
    def x4 = -2147483640;
    if (flag2) {
        x4 = x4 - a7; // underflow if a7 > 7
    }

}
