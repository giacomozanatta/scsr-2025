class OverflowUnderflowTests {

    // ----------- Integer Overflow / Underflow Tests -----------

    int_overflow_add() {
        def x = 32000;
        x = x + 2000; // INT16 overflow expected
    }

    int_underflow_sub() {
        def y = -32000;
        y = y - 2000; // INT16 underflow expected
    }

    int_overflow_mul() {
        def a = 200;
        def b = 200;
        def z = a * b; // 40.000 -> overflow in INT16
    }

    int_underflow_mul() {
        def c = -200;
        def d = 200;
        def w = c * d; // -40.000 -> underflow in INT16
    }

    int_overflow_div() {
        def e = -32768;
        def f = -1;
        def div = e / f; // overflow in INT16
    }


    // ----------- Unsigned 8-bit Overflow / Underflow -----------

    uint8_overflow_simple() {
        def u1 = 250;
        u1 = u1 + 20; // UINT8 overflow
    }

    uint8_underflow_simple() {
        def u2 = 5;
        u2 = u2 - 20; // UINT8 underflow
    }


    // ----------- Floating-Point Overflow / Underflow -----------

    float_overflow() {
        def fx = 60000.0;
        fx = fx * 2.0; // FLOAT16 overflow (> 65504)
    }

    float_underflow() {
        def fy = -60000.0;
        fy = fy * 2.0; // FLOAT16 underflow (< -65504)
    }


    // ----------- Control Flow Based Overflow -----------

    conditional_overflow(flag) {
        def gx = 32000;
        if (flag) {
            gx = gx + 2000; // overflow if flag is true
        }
    }


    // ----------- Loop-Based Overflow -----------

    loop_based_overflow() {
        def lx = 32000;
        def i = 0;
        while (i < 10) {
            lx = lx + 1000; // overflow after a few iterations
            i = i + 1;
        }
    }


    // ----------- Parameterized Overflow / Underflow -----------

    param_overflow_add(a_in) {
        def x1 = 32000;
        x1 = x1 + a_in; // overflow if a_in > 767
    }

    param_underflow_sub(b_in) {
        def x2 = -32000;
        x2 = x2 - b_in; // underflow if b_in > 767
    }

    param_overflow_mul(a2, b2) {
        def x3 = a2 * b2; // overflow if a2,b2 > 200
    }

    param_uint8_overflow(a3) {
        def u3 = 250;
        u3 = u3 + a3; // overflow if a3 > 5
    }

    param_uint8_underflow(a4) {
        def u4 = 5;
        u4 = u4 - a4; // underflow if a4 > 5
    }

    param_float_overflow(a5) {
        def f1 = 60000.0;
        f1 = f1 * a5; // overflow if a5 > ~1.1
    }

    param_float_underflow(a6) {
        def f2 = -60000.0;
        f2 = f2 * a6; // underflow if a6 < ~-1.1
    }

    param_loop_overflow(n) {
        def lp = 32000;
        def j = 0;
        while (j < n) {
            lp = lp + 1000; // overflow if n > 7
            j = j + 1;
        }
    }

    param_branch_underflow(flag2, a7) {
        def x4 = -32000;
        if (flag2) {
            x4 = x4 - a7; // underflow if a7 > 767
        }
    }

}
