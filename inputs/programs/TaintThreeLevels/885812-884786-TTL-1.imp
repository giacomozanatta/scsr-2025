class TaintTestProgram {

    source1(){
		return "taint";
	}

	sink1(v){
	}

    example(){
        // Simulate some tainted inputs
        def tainted_input = this.source1();  // imagine this is tainted
        def safe_input = "safe"; // untainted

        // Expressions mixing tainted and untainted
        def expr1 = tainted_input;          // tainted
        def expr2 = safe_input;             // untainted
        def expr3 = tainted_input + "safe";   // tainted because it uses tainted_input
        def expr4 = safe_input + " text";       // untainted

        // Passing expressions to "sink" parameters (simulated)
        this.sink1(expr1);  // tainted → should warn
        this.sink1(expr2);  // untainted → no warning
        this.sink1(expr3);  // tainted → should warn
        this.sink1(expr4);  // untainted → no warning
    }
}
