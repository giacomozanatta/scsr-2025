class TaintTests {

     source1(){
        return "taint";
    }


    sink1(v){
    }

    example(){
        // Tainted and untainted inputs
        def user = this.source1();          // tainted
        def fixed = "safe_string";   // untainted

        // Expressions
        def a = user;                // tainted
        def b = fixed;               // untainted
        def c = user + "_ok";        // tainted
        def d = fixed + "_log";      // untainted

        // Sinks
        this.sink1(a);   // tainted → warning
        this.sink1(b);   // untainted
        this.sink1(c);   // tainted → warning
        this.sink1(d);   // untainted
    }
}
