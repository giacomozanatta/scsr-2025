class TaintTestProgram {

    source1(){
        return "taint";
    }


    sink1(v){
	}
        // Simulate getting input data (tainted)

    getInput(i) {
        if (i % 2 == 0)
            return this.source1() + "user_data_" ;  // tainted input for even i
        else
            return "constant";        // untainted input for odd i
    }

    // Simulate a sink function annotated with @Sink
    logToDatabase(data) {
        this.sink1(data);
    }

    processInputs() {
        def i = 0;
        while (i < 10) {
            def data =  this.getInput(i);

            // Call sink with data
            this.logToDatabase(data);

            i = i + 1;
        }
    }

}