class TaintTestProgram {

    source1(){
        return "taint";
    }

    sink1(v){
    }

    // Simulate getting input (tainted for multiples of 3)
    getInput(i) {
        if (i % 3 == 0)
            return this.source1() + "tainted_";  // tainted input
        else
            return "clean_";    // untainted input
    }

    // Simulate sink function (annotated @Sink)
    sendToSink(data) {
        this.sink1(data);
    }

    runTest() {
        def i = 0;
        while (i < 10) {
            def inputData = this.getInput(i);

            if (inputData == this.source1()) {      // if inputData is tainted
                // tainted data path
                this.sendToSink(inputData);
            }

            i = i + 1;
        }
    }
}
