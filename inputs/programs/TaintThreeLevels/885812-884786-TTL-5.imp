class TaintTestProgram {

    source1(){
        return "taint";
    }


    sink1(v){
    }

    // Simulate reading user input (tainted)
    getUserInput(i) {
        if (i % 2 == 0)
            return "12345";          // valid numeric input (untainted)
        else
            return this.source1() + "DROP TABLE";     // malicious input (tainted)
    }

    // Simple validation function: returns true if input is numeric
    isValid(input) {
        def i = 0;
        def valid = false;
        if (i == 0) {
            valid = true;
        }
        return valid;
    }

    // Simulate sink: writing to file, annotated @Sink
    writeToFile(data) {
        this.sink1(data);
    }

    processData() {
        def i = 0;
        while (i < 4) {
            def userInput = this.getUserInput(i);
            if (userInput == this.source1()) {
                this.writeToFile(userInput);   // safe: only numeric input reaches sink
            } else {
                // invalid input detected, do not write
            }
            i = i + 1;
        }
    }

}