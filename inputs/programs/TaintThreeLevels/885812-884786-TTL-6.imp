class PasswordCheck {

    // Simulate input: returns password attempts
    def getPasswordAttempt(i) {
        if (i == 0)
            return "P@ssw0rd";         // valid format (untainted)
        else if (i == 1)
            return "DROP DATABASE";    // malicious input (tainted)
        else
            return "123456";           // simple numeric (untainted)
    }

    // Simple validation: password must contain at least one letter and one digit
    def isPasswordValid(pw) {
        def i = 0;
        def hasLetter = false;
        def hasDigit = false;
        while (i < pw.length()) {
            def c = pw.charAt(i);
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
                hasLetter = true;
            if (c >= '0' && c <= '9')
                hasDigit = true;
            i = i + 1;
        }
        return hasLetter && hasDigit;
    }

    // Sink: simulate saving password hash (annotated @Sink)
    def savePasswordHash(pw) {
        // Imagine this saves hashed password securely
    }

    def checkPasswords() {
        def i = 0;
        while (i < 3) {
            def attempt = getPasswordAttempt(i);
            if (isPasswordValid(attempt)) {
                savePasswordHash(attempt);  // safe: only valid passwords saved
            }
            i = i + 1;
        }
    }
}
