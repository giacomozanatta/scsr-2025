class PasswordCheck {

    source1(){
        return "taint";
    }

    sanitizer1(v){
        return "clean";
    }


    sink1(v){
    }


    // Simulate input: returns password attempts
    getPasswordAttempt(i) {
        if (i == 0)
            return "P@ssw0rd";         // valid format (untainted)
        else
            return this.source1() + "DROP DATABASE";    // malicious input (tainted)

    }

    // Simple validation: password must contain at least one letter and one digit
    isPasswordValid(pw) {
        def i = 0;
        def valid = false;
        if (i == 0) {
            valid = true;
        }
        return valid;
    }


    // Sink: simulate saving password hash (annotated @Sink)
    savePasswordHash(pw) {
        this.sink1(pw);
    }

    cleaner(pw){
        def clean = this.sanitizer1(pw);
        return clean;
    }

    checkPasswords() {
        def i = 0;
        def cleaned = this.cleaner("text");         // initialization
        def attempt = this.getPasswordAttempt(0);   // initialization
        while (i < 3) {
            attempt = this.getPasswordAttempt(i);
            if (this.isPasswordValid(attempt)) {
                this.savePasswordHash(attempt);  // safe: only valid passwords saved
            }
            else{
                cleaned = this.cleaner(attempt);

            }
            i = i + 1;
        }
    }
}
