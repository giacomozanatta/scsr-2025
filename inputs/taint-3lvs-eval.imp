class webapp {

	source1() {
		// Untrusted user input (e.g., from a web form)
		def user_input = 1;
		return user_input;
	}

	source2() {
		// Untrusted query parameter
		def query_param = 2;
		return query_param;
	}

	sanitizer1(input) {
		// Simulated sanitization (cleans input)
		def clean_input = input / 2; // e.g., validation or encoding
		return clean_input;
	}

	sanitizer2(input) {
		// Another sanitizer example
		def result = input + 1;
		return result;
	}

	sink1(cmd) {
		// Dangerous operation: shell command execution
		def run = cmd;
	}

	sinks(query) {
		// Dangerous operation: raw SQL query
		def exec = query;
	}

	process_direct_flow() {
		// Flow: tainted source directly to sink (should trigger DEFINITE warning)
		def tainted_data = this.source1();
		this.sink1(tainted_data);
	}

	process_sanitized_flow() {
		// Flow: tainted source passed through sanitizer (should NOT trigger warning)
		def user = this.source2();
		def safe = this.sanitizer1(user);
		this.sinks(safe);
	}

	process_partial_sanitization() {
		// Flow: partial sanitization but not fully trusted (should trigger POSSIBLE warning)
		def q = this.source2();
		def partial = q + 1; // not a real sanitization
		this.sink1(partial);
	}
}
